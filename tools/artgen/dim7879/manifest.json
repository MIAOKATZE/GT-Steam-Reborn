  "STYLE": {
    "pixel_discipline": {
      "size": [16, 16],
      "max_distinct_rgb": 16,
      "forbid_rgb": ["000000", "FFFFFF"],
      "alpha": 255,
      "palette_gate": "不透明贴图：每张 distinct RGB ≤ 16、alpha 恒 255、全图禁纯黑/纯白（锚点亦非极值）。十字装饰：alpha 二值（前景 255 / 背景 0），背景像素 RGB 必须为 (0,0,0,0) 且**不计入** distinct RGB 与纯黑禁则，前景仍受 ≤16 与禁纯黑/纯白约束。",
      "period_rule": "一切 % 取模周期（ripple/fiber/strata/course）的周期必须整除 16（1/2/4/8/16），否则环绕断裂；格点值噪无此约束（u 前进整数格点，mod cells 后逐点精确相等）。"
    },
    "prosperity_natural": {
      "_note": "dim78 自然地表（四群系 top/base + 锈树叶）：锈色系，明度中低-中；四群系读感互异 = 锈褐草甸 / 铜绿齿轮林 / 黄铜沙丘 / 泥炭沼。地表类四边无缝（周期 16 场 + 环绕落笔）。",
      "octaves": [[2, 0.20], [4, 0.30], [8, 0.30], [16, 0.20]],
      "tileable": true,
      "seam_gross_max": 1.5,
      "_seam_metric": "gross = 环边相邻差 / 内部相邻差最大值（杀硬缝的粗检，必要非充分；场断裂/边缘描边类硬缝实测 >2）；无缝充分保证 = 噪声场精确周期 16 自证 + 环绕落笔"
    },
    "prosperity_side": {
      "_note": "dim78 表层侧面（kind=crust_side，输出自身带 seam_axes=x）：草沿/腐殖沿锚顶（顶部 2-4px）+ 土体在下（复用同族 base 调色板），故只在水平（x）方向自拼接；垂直向顶部沿对其下方土体是设计不连续。",
      "seam_gross_max": 1.5,
      "seam_axes": "x"
    },
    "prosperity_decor": {
      "_note": "dim78 装饰（2 草丛十字 + 锈树干 side/top）：草丛透明底、树干构件化；明度中低，破损感靠锈斑/纤维/裂纹。",
      "tileable": false,
      "seam_gross_max": 1.5
    },
    "shattered_natural": {
      "_note": "dim79 破碎之地地表（碎核岩 + 四群系 top/base）：超硬暗色调，与 dim78 锈色系拉开（全族基色明度 32..144，暗端比 dim78 低一档）；四群系读感互异 = 灰烬 / 渣木橄榄 / 琉璃冷蓝 / 焦油近黑。硬石风靠棱面/裂纹/矿脉，不靠有机软噪。",
      "octaves": [[2, 0.18], [4, 0.32], [8, 0.30], [16, 0.20]],
      "tileable": true,
      "seam_gross_max": 1.5,
      "_seam_metric": "同 prosperity_natural：gross 粗检（阈值 1.5）+ 周期场自证"
    },
    "shattered_side": {
      "_note": "dim79 表层侧面（kind=crust_side，seam_axes=x）：壳层锚顶（顶部 3-4px，灰烬/渣壳/琉璃层/焦油壳）+ 下层 base 主体，只断言水平环边。",
      "seam_gross_max": 1.5,
      "seam_axes": "x"
    },
    "shattered_decor": {
      "_note": "dim79 装饰（monolith 结构块 + 石刺簇/灰烬棘丛十字 + 灰烬枯树干 side/top）：十字透明底；monolith 与 log_side 为构造/构件面，不做拼接硬性要求时按 entry.tileable 声明。",
      "tileable": false,
      "seam_gross_max": 1.5
    },
    "cross_rules": {
      "_note": "十字装饰（getRenderType=1）共用断言：alpha 二值；落地生根（最下一行至少 N 个前景像素，否则飘空）；覆盖率区间（防糊成实心块 or 稀到看不见）。",
      "alpha_binary": true,
      "bottom_row_fg_min": 3,
      "coverage_min": 0.12,
      "coverage_max": 0.62
    }
  },
